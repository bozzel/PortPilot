{
  "name": "portpilot",
  "productName": "PortPilot",
  "version": "1.0.4",
  "description": "PortPilot: controller-poortplanner voor xLights",
  "author": "Laserworx",
  "main": "main.js",
  "private": true,
  "scripts": {
    "app": "node build_app.js",
    "start": "node build_app.js && electron .",
    "build": "node build_app.js && electron-builder --win dir --x64 && node stamp_exe.js dist/win-unpacked/PortPilot.exe && electron-builder --win portable --x64 --prepackaged dist/win-unpacked"
  },
  "build": {
    "appId": "nl.laserworx.portpilot",
    "productName": "PortPilot",
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "artifactName": "PortPilot-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PortPilot",
      "artifactName": "PortPilot-Setup-${version}.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "PortPilot-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "pe-library": "1.0.1",
    "resedit": "2.0.3"
  }
}
